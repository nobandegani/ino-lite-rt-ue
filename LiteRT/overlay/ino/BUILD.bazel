#
# InoLiteRT custom Bazel target: produces LiteRtLm.dll for consumption
# by the InoLiteRT Unreal Engine plugin.
#
# This file is staged into LiteRT-LM's source tree by
#   Plugins/InoLiteRT/LiteRT/scripts/setup.ps1
# from its canonical location at
#   Plugins/InoLiteRT/LiteRT/overlay/ino/BUILD.bazel
#
# Do not edit the copy inside the submodule — edit the overlay source instead.
#
# Export mechanism (Windows):
#   The C API in //c:engine's engine.h already annotates every public
#   function with __declspec(dllexport) via the LITERT_LM_C_API_EXPORT macro
#   (enabled on _WIN32). Because we do NOT pass a /DEF: file to the linker,
#   MSVC's linker uses these annotations as the authoritative export list and
#   /OPT:REF dead-stripping preserves every symbol transitively reachable from
#   them.
#
#   Note: runtime/engine:litert_lm_main uses a /DEF:windows_exported_symbols.def
#   linkopt to export the internal LiteRt* accelerator ABI symbols (so a
#   separate WebGPU accelerator .dll can load against the main executable).
#   That is a different pattern from a plain shared library exposing a C API.
#   We intentionally do not replicate it here because:
#     (a) Using /DEF overrides __declspec(dllexport) — only symbols listed in
#         the .def file get exported, and /OPT:REF dead-strips everything else.
#         Building with both resulted in a 12 MB DLL with zero litert_lm_*
#         exports.
#     (b) We use --config=monolithic (set by upstream .bazelrc's build:windows
#         config) which links the GPU accelerator statically into our DLL. No
#         separate accelerator DLL is produced, so the LiteRt* accelerator ABI
#         does not need to be exported.

package(default_visibility = ["//visibility:private"])

licenses(["notice"])

cc_binary(
    name = "LiteRtLm",
    srcs = ["LiteRtLm_exports.cc"],
    linkshared = 1,
    linkstatic = 1,
    # Per-platform linkopts. Two distinct concerns:
    #   Windows: /EXPORT: flags are ADDITIVE to __declspec(dllexport) — they
    #     add symbols to the DLL export table without replacing the
    #     compiler-driven exports (unlike /DEF: which is exclusive).
    #   Android: the //c:engine dep graph brings in EGL/GLES3 calls that
    #     would otherwise be undefined at load time. Upstream's own
    #     //runtime/engine:litert_lm_main target links -lEGL -lGLESv3
    #     on Android (see runtime/engine/BUILD, select on @platforms//os:android);
    #     we do the same here for parity. Without these the produced .so may
    #     still link (missing symbols are deferred to dlopen time on Android)
    #     but then crash with "cannot locate symbol eglGetCurrentContext"
    #     when Android's dynamic linker actually maps it into a process.
    linkopts = select({
        "@platforms//os:windows": [
            # No additional Windows linkopts. (Earlier pins of LiteRT-LM
            # required /EXPORT:litert_lm_set_min_log_level to work around an
            # upstream bug where c/litert_lm_logging.h declared the function
            # without __declspec(dllexport). The standalone logging header
            # was removed in newer commits; litert_lm_set_min_log_level is
            # now declared with LITERT_LM_C_API_EXPORT in c/engine.h directly,
            # so the standard force-reference path in LiteRtLm_exports.cc
            # is sufficient.)
        ],
        "@platforms//os:android": [
            # The //c:engine dep graph brings in EGL/GLES3 calls that would
            # otherwise be undefined at load time. Upstream's own
            # //runtime/engine:litert_lm_main target links -lEGL -lGLESv3
            # on Android (see runtime/engine/BUILD, select on
            # @platforms//os:android); we do the same here for parity.
            # Without these the produced .so may still link (missing symbols
            # are deferred to dlopen time on Android) but then crash with
            # "cannot locate symbol eglGetCurrentContext" when Android's
            # dynamic linker actually maps it into a process.
            "-lEGL",
            "-lGLESv3",
        ],
        "@platforms//os:osx": [
            # macOS arm64 (Apple Silicon). The //c:engine dep graph pulls in
            # CPU-only paths by default; libLiteRtLm.dylib does NOT directly
            # call Metal — the prebuilt libLiteRtMetalAccelerator.dylib /
            # libLiteRtTopKMetalSampler.dylib do, and they're loaded at
            # runtime via dlopen by the LiteRT engine. So we don't need
            # -framework Metal here.
            #
            # Upstream's build:macos sets --linkopt=-Wl,-undefined,dynamic_lookup
            # which lets us defer libLiteRt.dylib symbol resolution to dlopen
            # time. With --define=litert_link_capi_so=true the build expects
            # libLiteRt.dylib to satisfy those undefineds at runtime; since
            # we ship the prebuilt libLiteRt.dylib alongside libLiteRtLm.dylib
            # and the install_name fix-up step in build-macos.sh sets both
            # to @rpath form, the dyld runtime loader resolves them
            # correctly when the consuming app loads them in order.
        ],
        "@platforms//os:ios": [
            # iOS (device arm64 + simulator arm64). Same reasoning as macOS:
            # Metal is loaded via the prebuilt accelerator dylib at runtime
            # rather than at link time. iOS does NOT support
            # -Wl,-undefined,dynamic_lookup the way macOS does (App Store
            # validation rejects it), so the build relies on each dylib
            # listing its imports explicitly. The litert_link_capi_so build
            # variant declares libLiteRt.dylib as a runtime dependency
            # which the iOS dynamic loader honors when our framework
            # wrapping (build-ios.sh) sets matching @rpath install_names
            # on every staged dylib.
        ],
        "//conditions:default": [],
    }),
    deps = [
        # //c:engine is the maximal engine target (c/BUILD: the only
        # non-cpu-only variant; the alternative is //c:engine_cpu).
        # IMPORTANT (source, litert @ d865fd82): GPU/NPU accelerators are
        # NOT linked into this binary. runtime/core:engine_impl's
        # default_static_gpu_accelerator / default_static_gpu_samplers are
        # empty shells in every select() branch, litert
        # build_common/special_rule.bzl litert_gpu_accelerator_deps()
        # returns [] ("no-op outside Google"), and
        # LiteRtStaticLinkedAcceleratorGpuDef is permanently nullptr. So
        # //ino:LiteRtLm is CPU/XNNPACK on every platform; ALL GPU and NPU
        # capability is delivered by runtime dlopen of the prebuilt libs
        # staged next to it (gpu_registry.cc / litert_dispatch.cc). The
        # NPU compiled-model executor IS compiled in here (except iOS,
        # where runtime/executor/BUILD force-sets LITERT_DISABLE_NPU) but
        # is inert until a vendor libLiteRtDispatch_* lib is present.
        #
        # Backend is chosen at RUNTIME via backend_str passed to
        # litert_lm_engine_settings_create ("cpu" / "gpu" / NPU); it is
        # not a compile-time switch and does not change the C-API surface.
        # Per-platform GPU accelerator: Win64 = WebGPU/Dawn (D3D12 via
        # DXC; there is NO Vulkan accelerator lib in the tree despite
        # LITERT_HAS_VULKAN defaulting on for Windows), Android =
        # OpenCL+WebGPU, Apple = Metal+WebGPU.
        "//c:engine",
    ],
)
