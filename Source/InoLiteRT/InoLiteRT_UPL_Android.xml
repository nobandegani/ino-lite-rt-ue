<?xml version="1.0" encoding="utf-8"?>
<!--

InoLiteRT module — Unreal Plugin Language (UPL) file for Android packaging.

Referenced from InoLiteRT.Build.cs via
    AdditionalPropertiesForReceipt.Add("AndroidPlugin", "<this file>")

Supports both Android architectures (arm64-v8a and x86_64). UPL is
processed once per architecture; bSupported is set per-arch via
<isArch>, so the <copyFile> directives only run for arches we actually
ship .so files for.

UPL has two distinct concerns that are easy to confuse:

  1. Java-side loadLibrary calls — inject System.loadLibrary("foo")
     calls into the generated GameActivity Java. Done via
     <soLoadLibrary><loadLibrary name="foo"/></soLoadLibrary>.
     This does NOT copy the .so file into the APK. Architecture-agnostic
     (Java side doesn't care which ABI is loaded).

  2. Native library file staging — copy .so files into the APK's
     lib/<arch>/ directory. Done via <resourceCopies> with
     <copyFile src=".." dst="$S(BuildDir)/libs/$S(Architecture)/.."/>.
     This does NOT emit any Java loadLibrary calls.

Both are required for libraries we want Android to preload. The GPU
accelerator .so files only need (2) because the LiteRT engine dlopens
them on demand.

Path variables:

  $S(AbsPluginDir)   — the directory containing this XML file:
                       Plugins/InoLiteRT/Source/InoLiteRT/
                       (despite "Plugin" in the name — this is how
                        UE's UPL engine names it; for an XML loaded
                        from a module's Build.cs it resolves to the
                        module's directory)
  $S(BuildDir)       — Intermediate/Android/<arch>/gradle/app/src/main/
  $S(Architecture)   — arm64-v8a or x86_64.

Our .so files live at
    Plugins/InoLiteRT/Source/ThirdParty/Android/<arch>/
which is one dir up + over from $S(AbsPluginDir) = Source/InoLiteRT/.
The <copyFile> src uses $S(Architecture) so it picks the right subdir
automatically per build.

IMPORTANT: $S(PluginDir) (non-Abs) does NOT exist — using it produces
an empty string and silently breaks the copy. Always use $S(AbsPluginDir).

If you only built one architecture (e.g. arm64-v8a but not x86_64),
the bSupported gating below still runs <copyFile> for that arch but
will fail with "source file not found" if the target arch isn't built.
Run build-android.ps1 -Arch x86_64 if you intend to ship x86_64.

Docs: https://docs.unrealengine.com/en-US/Sharing/Reference/UnrealPluginLanguage/

-->
<root xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- File trace: UE logs a line whenever this UPL is processed. -->
	<trace enable="true"/>

	<!--
	init: runs once per architecture. Match the stock UE pattern (see
	Engine/Source/ThirdParty/libGPUCounters/libGPUCounters_UPL.xml):
	gate the copies on architecture so we don't try to copy our .so
	files for an arch we don't support. We support both arm64-v8a and
	x86_64.
	-->
	<init>
		<log text="InoLiteRT UPL init"/>
		<setBool result="bSupported" value="false"/>
		<isArch arch="arm64-v8a">
			<setBool result="bSupported" value="true"/>
		</isArch>
		<isArch arch="x86_64">
			<setBool result="bSupported" value="true"/>
		</isArch>
		<if condition="bSupported">
			<false>
				<log text="InoLiteRT: unsupported architecture $S(Architecture), skipping native lib staging"/>
			</false>
		</if>
	</init>

	<!--
	soLoadLibrary: emit System.loadLibrary("<name>") calls in the Java
	launcher activity so these libraries are loaded before libUnreal.so
	starts executing. This element does NOT copy files — see
	<resourceCopies> below for that.

	NOTE: No libLiteRt.so on Android. Upstream's build:android forces
	static linking (dynamic_mode=off) so all LiteRT core code is
	statically linked into libLiteRtLm.so (monolithic ~52 MB).

	Order:
	  1. libGemmaModelConstraintProvider.so — standalone
	  2. libLiteRtLm.so — the monolithic LiteRT + LiteRT-LM bundle

	GPU accelerator .so files are loaded on demand via dlopen by the
	LiteRT engine itself; they're packaged but not preloaded here.
	-->
	<soLoadLibrary>
		<loadLibrary name="GemmaModelConstraintProvider" failmsg="Failed to load libGemmaModelConstraintProvider.so"/>
		<loadLibrary name="LiteRtLm" failmsg="Failed to load libLiteRtLm.so"/>
	</soLoadLibrary>

	<!--
	resourceCopies: copy every .so into the APK's lib/$S(Architecture)/
	directory (arm64-v8a or x86_64). ALL of our native libraries must
	be listed here, including libLiteRtLm.so and libGemmaModelConstraintProvider.so.

	Source paths use $S(AbsPluginDir)/../ThirdParty/Android/$S(Architecture)/...
	because $S(AbsPluginDir) resolves to the module directory
	(Plugins/InoLiteRT/Source/InoLiteRT/), and our .so files are
	one dir up + over under Source/ThirdParty/Android/<arch>/.

	$S(Architecture) is the arch UPL is currently being processed for —
	UPL re-runs per architecture, so the copy directives are auto-routed
	to the matching subdirectory.

	<log> lines print to the packaging log so we can verify each copy
	actually ran. Look for "InoLiteRT: copied <name>" in the output.
	-->
	<resourceCopies>
		<if condition="bSupported">
			<true>
				<copyFile
					src="$S(AbsPluginDir)/../ThirdParty/Android/$S(Architecture)/libLiteRtLm.so"
					dst="$S(BuildDir)/libs/$S(Architecture)/libLiteRtLm.so"/>
				<log text="InoLiteRT: copied libLiteRtLm.so"/>

				<copyFile
					src="$S(AbsPluginDir)/../ThirdParty/Android/$S(Architecture)/libGemmaModelConstraintProvider.so"
					dst="$S(BuildDir)/libs/$S(Architecture)/libGemmaModelConstraintProvider.so"/>
				<log text="InoLiteRT: copied libGemmaModelConstraintProvider.so"/>

				<copyFile
					src="$S(AbsPluginDir)/../ThirdParty/Android/$S(Architecture)/libLiteRtGpuAccelerator.so"
					dst="$S(BuildDir)/libs/$S(Architecture)/libLiteRtGpuAccelerator.so"/>
				<log text="InoLiteRT: copied libLiteRtGpuAccelerator.so"/>

				<copyFile
					src="$S(AbsPluginDir)/../ThirdParty/Android/$S(Architecture)/libLiteRtOpenClAccelerator.so"
					dst="$S(BuildDir)/libs/$S(Architecture)/libLiteRtOpenClAccelerator.so"/>
				<log text="InoLiteRT: copied libLiteRtOpenClAccelerator.so"/>

				<copyFile
					src="$S(AbsPluginDir)/../ThirdParty/Android/$S(Architecture)/libLiteRtTopKOpenClSampler.so"
					dst="$S(BuildDir)/libs/$S(Architecture)/libLiteRtTopKOpenClSampler.so"/>
				<log text="InoLiteRT: copied libLiteRtTopKOpenClSampler.so"/>

				<copyFile
					src="$S(AbsPluginDir)/../ThirdParty/Android/$S(Architecture)/libLiteRtTopKWebGpuSampler.so"
					dst="$S(BuildDir)/libs/$S(Architecture)/libLiteRtTopKWebGpuSampler.so"/>
				<log text="InoLiteRT: copied libLiteRtTopKWebGpuSampler.so"/>

				<copyFile
					src="$S(AbsPluginDir)/../ThirdParty/Android/$S(Architecture)/libLiteRtWebGpuAccelerator.so"
					dst="$S(BuildDir)/libs/$S(Architecture)/libLiteRtWebGpuAccelerator.so"/>
				<log text="InoLiteRT: copied libLiteRtWebGpuAccelerator.so"/>
			</true>
		</if>
	</resourceCopies>

</root>
